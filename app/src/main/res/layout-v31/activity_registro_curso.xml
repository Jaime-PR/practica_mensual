<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5FB"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:ignore="TooWide">

    <!-- BARRA SUPERIOR -->
    <FrameLayout
        android:id="@+id/linearLayoutHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#154273"
        android:elevation="8dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnRegresar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/regresar"
            android:src="@drawable/flecha_regreso"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="@string/registro_al_curso"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- FRANJA DE ACENTO -->
    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="#2E9E4F" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvInscripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:lineSpacingExtra="3dp"
                android:text="@string/inscripci_n_nprogramaci_n_avanzada"
                android:textColor="#154273"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- CONTENEDOR DEL CURSO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_tarjeta_curso"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/imgCurso"
                    android:layout_width="100dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_imagen_curso"
                    android:clipToOutline="true"
                    android:contentDescription="@string/imagen_del_curso"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/txtNombreCurso"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/programaci_n_navanzada"
                    android:textColor="#154273"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- MATRÍCULA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="@string/matr_cula_del_alumno"
                android:textColor="#154273"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtMatricula"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints="username"
                android:background="@drawable/bg_campo"
                android:hint="@string/ej_20251015"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:textColor="#1B1F27"
                android:textColorHint="#4A5568"
                android:textSize="15sp" />

            <!-- FECHA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="@string/fecha_de_registro"
                android:textColor="#154273"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtFechaRegistro"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints="birthDate"
                android:background="@drawable/bg_campo"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:focusable="false"
                android:hint="@string/dd_mm_aaaa"
                android:inputType="none"
                android:paddingHorizontal="16dp"
                android:textColor="#1B1F27"
                android:textColorHint="#4A5568"
                android:textSize="15sp" />

            <!-- CORREO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="@string/correo_institucional"
                android:textColor="#154273"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtCorreo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_campo"
                android:hint="@string/ejemplo_universidad_edu"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColor="#1B1F27"
                android:textColorHint="#4A5568"
                android:textSize="15sp" />

            <!-- BOTONES -->
            <Button
                android:id="@+id/btnConfirmarinscripción"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_boton_confirmar"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:stateListAnimator="@null"
                android:text="@string/confirmar_inscripci_n"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_boton_cancelar"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:stateListAnimator="@null"
                android:text="@string/cancel"
                android:textColor="#154273"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>