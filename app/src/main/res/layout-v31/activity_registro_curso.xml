<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5FB"
    android:orientation="vertical">

    <!-- BARRA SUPERIOR -->
    <FrameLayout
        android:id="@+id/linearLayoutHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#154273"
        android:elevation="8dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnRegresar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/btnregresar"
            android:src="@drawable/flecha_regreso"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="REGISTRO AL CURSO"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- FRANJA DE ACENTO -->
    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="#2E9E4F" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">

            <!-- ETIQUETA FIJA -->
            <TextView
                android:id="@+id/tvInscripcionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="INSCRIPCIÓN:"
                android:textColor="#154273"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- NOMBRE DINÁMICO DEL CURSO (DESDE LA BD) -->
            <TextView
                android:id="@+id/tvNombreCursoTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:textColor="#154273"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- CONTENEDOR DEL CURSO (imagen + nombre) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_tarjeta_curso"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/imgCurso"
                    android:layout_width="90dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_imagen_curso"
                    android:clipToOutline="true"
                    android:contentDescription="@string/imagen_del_curso"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/txtNombreCurso"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="#154273"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- NOMBRE DEL ALUMNO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="NOMBRE DEL ALUMNO:"
                android:textColor="#154273"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtNombreAlumno"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:autofillHints="name"
                android:background="@drawable/bg_campo"
                android:hint="Ej. Juan Pérez"
                android:inputType="textPersonName"
                android:paddingHorizontal="16dp"
                android:textColor="#1B1F27"
                android:textColorHint="#7A8699"
                android:textSize="14sp" />

            <!-- MATRÍCULA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="@string/matr_cula_del_alumno"
                android:textColor="#154273"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtMatricula"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:autofillHints="username"
                android:background="@drawable/bg_campo"
                android:hint="@string/ej_20251015"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:textColor="#1B1F27"
                android:textColorHint="#7A8699"
                android:textSize="14sp" />

            <!-- FECHA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="@string/fecha_de_registro"
                android:textColor="#154273"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtFechaRegistro"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:autofillHints="birthDate"
                android:background="@drawable/bg_campo"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                android:drawableTint="#154273"
                android:focusable="false"
                android:hint="@string/dd_mm_aaaa"
                android:inputType="none"
                android:paddingHorizontal="16dp"
                android:textColor="#1B1F27"
                android:textColorHint="#7A8699"
                android:textSize="14sp" />

            <!-- CORREO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="@string/correo_institucional"
                android:textColor="#154273"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_campo"
                android:hint="20281015@uthh.edu.mx"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColor="#1B1F27"
                android:textColorHint="#7A8699"
                android:textSize="14sp" />

            <!-- BOTONES -->
            <Button
                android:id="@+id/btnConfirmar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_boton_confirmar"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:stateListAnimator="@null"
                android:text="@string/confirmar_inscripci_n"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_boton_cancelar"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:stateListAnimator="@null"
                android:text="CANCEL"
                android:textColor="#154273"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>